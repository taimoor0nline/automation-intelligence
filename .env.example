# TestNexus AI — platform configuration

# Demo application
DEMO_APP_PORT=4000

# TestNexus AI backend/UI
SERVER_PORT=5000

# PostgreSQL persistence
# PostgreSQL is strictly opt-in. When DATABASE_ENABLED=false, DATABASE_URL is ignored
# and the application must not load pg, create a pool, resolve the DB host or make a DB network call.
# Canonical element registries, generation plans and Canonical Test IR remain in session
# memory in this mode.
DATABASE_ENABLED=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automation_intelligence
DATABASE_REQUIRED=false
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=1500
DATABASE_HEALTH_TIMEOUT_MS=1800
# When enabling PostgreSQL, run `npm run db:migrate` after creating/upgrading the database.
# Migration 011 persists the canonical registry, strict coverage plan and Canonical Test IR.
# With DATABASE_ENABLED=true, non-secret automation capability profiles can also be
# loaded from automation_capability_config / automation_db_assertion_query.

# Platform authentication / roles
AUTH_REQUIRED=false
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=8h

# Source-aware developer remediation
GITHUB_SOURCE_TOKEN=
SOURCE_MAX_TREE_FILES=800
SOURCE_MAX_CANDIDATES=8
SOURCE_MAX_FILE_BYTES=180000

# -----------------------------------------------------------------------------
# AI test generation — Canonical IR architecture
# -----------------------------------------------------------------------------

# Default architecture:
# Discovery -> Canonical Element Registry -> Coverage Planner -> strict planned unit ->
# AI Canonical JSON -> deterministic Canonical IR validator -> Automation Readiness.
# English steps/expected results are display text only for newly AI-generated cases.
# Keep true. false is an emergency rollout fallback to the previous scalable English DSL.
AUTOMATION_CANONICAL_IR_ENABLED=true

# HARD UPPER LIMIT only. The coverage planner may generate fewer cases when fewer
# distinct evidence-grounded scenarios provide sufficient coverage; it never needs to pad.
# Demo: 6. Production suites can use 100-200; implementation safety ceiling is 250.
AI_TEST_CASE_COUNT=6

# SSE + real AI batching remain enabled with Canonical IR.
# Demo: batch size 1 makes generation/readiness visibly overlap case-by-case.
# Production 100-200 cases: start with batch size 5, concurrency 3, readiness 6.
AI_GENERATION_BATCH_SIZE=1
AI_GENERATION_CONCURRENCY=2
READINESS_CONCURRENCY=4
# Production example:
# AI_TEST_CASE_COUNT=200
# AI_GENERATION_BATCH_SIZE=5
# AI_GENERATION_CONCURRENCY=3
# READINESS_CONCURRENCY=6

# Bound a generation batch so one provider request cannot freeze the whole suite.
# Failed multi-case batches are split into smaller batches automatically by default.
AI_GENERATION_BATCH_TIMEOUT_MS=120000
AI_GENERATION_BATCH_MAX_ATTEMPTS=1
AI_GENERATION_SPLIT_FAILED_BATCHES=true

# Legacy timeout names remain fallback-only for the previous scalable route.
# AI_GENERATION_UNIT_TIMEOUT_MS=120000
# AI_GENERATION_UNIT_MAX_ATTEMPTS=1

# Automation Ready remains strict. Canonical IR assertions are schema-validated and
# resolve elementRef/path references against the canonical discovery registry.
AUTOMATION_MIN_EXPECTATION_COVERAGE_PERCENT=100

AI_FAILURE_ANALYSIS_CONCURRENCY=2
MAX_REVIEWED_TEST_CASES=500

# AI provider
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL_FAST=qwen3.5-flash
AI_MODEL_BALANCED=qwen3.7-plus
AI_MODEL_STRONG=qwen3.8-max
AI_MODEL_DEFAULT=balanced
# Provider request aborts before the outer 120-second generation batch timeout.
QWEN_TIMEOUT_MS=90000
QWEN_MAX_RETRIES=0

# -----------------------------------------------------------------------------
# Browser automation
# -----------------------------------------------------------------------------

TEST_BASE_URL=http://localhost:4000
AUTOMATION_BROWSER=chrome
AUTOMATION_HEADED=true
AUTOMATION_EXECUTION_MODE=isolated

AUTOMATION_STEP_DELAY_MS=150
AUTOMATION_TEST_COMPLETION_PAUSE_MS=5000

AUTOMATION_SCREENSHOT_EACH_TEST=true
AUTOMATION_SCREENSHOT_ON_FAILURE=true
AUTOMATION_VIDEO=false

AUTOMATION_LIVE_STREAM=true
AUTOMATION_LIVE_STREAM_PORT=9223

AUTOMATION_ENGINE_TIMEOUT_MS=600000
AUTOMATION_ENGINE_EXIT_GRACE_MS=20000

# -----------------------------------------------------------------------------
# Advanced deterministic browser capabilities
# -----------------------------------------------------------------------------

# Visual regression. Approved PNG baselines live here.
# compare        = normal mode; compare against an existing approved baseline and
#                  fail readiness/runtime if the baseline is missing.
# create-missing = controlled baseline-approval mode; create ONLY a missing baseline.
#                  Existing baselines are still compared and are never silently replaced.
AUTOMATION_VISUAL_BASELINE_DIR=./automation-system/baselines
AUTOMATION_VISUAL_BASELINE_MODE=compare
# Legacy compatibility only; prefer AUTOMATION_VISUAL_BASELINE_MODE.
# AUTOMATION_VISUAL_UPDATE_BASELINES=false

# Safe browser file-upload fixtures. Canonical tests reference file names only;
# paths outside this directory are rejected by the runtime.
AUTOMATION_UPLOAD_FIXTURE_DIR=./automation-system/fixtures/uploads

# Camera/microphone tests can use Chromium fake media devices in controlled test runs.
AUTOMATION_FAKE_MEDIA_PERMISSIONS=false

# Named read-only application-under-test database assertions.
# This is INDEPENDENT of DATABASE_ENABLED. DATABASE_ENABLED controls TestNexus platform
# persistence; these settings control verification against the tested application's DB.
AUTOMATION_DB_ASSERTIONS_ENABLED=false
AUTOMATION_DB_ASSERTION_URL=
AUTOMATION_DB_ASSERTION_TIMEOUT_MS=3000
# Simple query with no parameters:
# {"feedback_count":"SELECT count(*)::int AS count FROM feedback"}
# Parameterized query: declare reviewed testData keys once. The runtime takes values
# only from reviewed test data and passes them to $1, $2, ... in order.
# {"feedback_created":{"sql":"SELECT status FROM feedback WHERE id=$1","params":["feedbackId"]}}
AUTOMATION_DB_ASSERTION_QUERIES_JSON={}

# External capability adapter for workflows the browser runner cannot safely/faithfully own:
# email/SMS/OTP providers, real cross-origin iframe control, real multi-tab browser
# contexts, non-production CAPTCHA/biometric test adapters, native mobile,
# browser-extension UI and native OS dialogs.
AUTOMATION_EXTERNAL_ADAPTER_URL=
AUTOMATION_EXTERNAL_ADAPTER_TOKEN=
# Optional indirection: keep the actual token in another environment/secret variable.
AUTOMATION_EXTERNAL_ADAPTER_TOKEN_ENV=
AUTOMATION_EXTERNAL_ADAPTER_TIMEOUT_MS=15000
# Empty means all recognized adapter capabilities may be requested when an adapter URL
# is configured. To restrict it, use a comma-separated allow-list such as:
# EMAIL_SMS_OTP,CROSS_ORIGIN_IFRAME,REAL_MULTI_TAB,CAPTCHA_BIOMETRIC,NATIVE_MOBILE,BROWSER_EXTENSION,OS_DIALOG
AUTOMATION_EXTERNAL_CAPABILITIES=

# Page-discovery cache
DISCOVERY_CACHE_TTL_MS=300000
