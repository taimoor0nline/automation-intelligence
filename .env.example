# TestNexus AI — platform configuration

# Demo application
DEMO_APP_PORT=4000

# TestNexus AI backend/UI
SERVER_PORT=5000

# PostgreSQL persistence
# PostgreSQL is strictly opt-in. When DATABASE_ENABLED=false, DATABASE_URL is ignored
# and the application must not create a PostgreSQL pool or make a database network call.
DATABASE_ENABLED=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_testpilot
DATABASE_REQUIRED=false
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=1500
DATABASE_HEALTH_TIMEOUT_MS=1800
# When enabling PostgreSQL, run `npm run db:migrate` after creating the database.

# Platform authentication / roles
# Local/demo mode can run without platform authentication.
AUTH_REQUIRED=false
# REQUIRED in production when authentication is enabled: replace with a long cryptographically-random secret.
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=8h

# Source-aware developer remediation
# Server-side only. Required for private GitHub repositories and recommended
# for public repositories to avoid anonymous GitHub API rate limits.
GITHUB_SOURCE_TOKEN=
SOURCE_MAX_TREE_FILES=800
SOURCE_MAX_CANDIDATES=8
SOURCE_MAX_FILE_BYTES=180000

# AI test generation
# HARD UPPER LIMIT only. The AI coverage planner may generate fewer cases when fewer
# distinct evidence-grounded scenarios provide sufficient coverage; it must never pad to this number.
AI_TEST_CASE_COUNT=6
# Progressive generation uses small independent work units and streams each result as it finishes.
# AI_GENERATION_CONCURRENCY controls how many AI generation work units run in parallel.
# 2 is a good default: faster than fully serial generation without overloading the provider.
# Allowed runtime range: 1-4.
AI_GENERATION_CONCURRENCY=2

# Browser automation target fallback
TEST_BASE_URL=http://localhost:4000
AUTOMATION_BROWSER=chrome
AUTOMATION_HEADED=true

# Isolated execution: every approved test gets a fresh owned Chrome instance.
# Screenshot is captured after assertions and before the completion pause/cleanup.
AUTOMATION_SCREENSHOT_EACH_TEST=true
# Keep the completed browser state visible before TestNexus AI closes that test's Chrome.
# 5000 = 5 seconds. Set to 0 for unattended/CI execution.
AUTOMATION_TEST_COMPLETION_PAUSE_MS=5000

# Experimental remote live browser viewer
AUTOMATION_LIVE_STREAM=true
AUTOMATION_LIVE_STREAM_PORT=9223

# Additional evidence capture
AUTOMATION_VIDEO=false
AUTOMATION_SCREENSHOT_ON_FAILURE=true

# Optional visible presentation delay between individual browser actions.
# This is separate from AUTOMATION_TEST_COMPLETION_PAUSE_MS.
AUTOMATION_STEP_DELAY_MS=150

# Browser-engine lifecycle safety.
AUTOMATION_ENGINE_TIMEOUT_MS=120000
AUTOMATION_ENGINE_EXIT_GRACE_MS=10000

# AI provider
# Keep the real key only in your local .env file. Never commit it.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Three selectable server-side model profiles. The public UI exposes only
# Fast / Balanced / Strong and never reveals provider/model names.
AI_MODEL_FAST=qwen3.5-flash
AI_MODEL_BALANCED=qwen3.7-plus
AI_MODEL_STRONG=qwen3.8-max
AI_MODEL_DEFAULT=strong
QWEN_MODEL=qwen3.5-flash

# Model request controls.
QWEN_TIMEOUT_MS=300000
QWEN_MAX_RETRIES=1

# Page-discovery cache. 300000 = 5 minutes. Set to 0 to disable globally.
DISCOVERY_CACHE_TTL_MS=300000
