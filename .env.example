# TestNexus AI — platform configuration

# Demo application
DEMO_APP_PORT=4000

# TestNexus AI backend/UI
SERVER_PORT=5000

# PostgreSQL persistence
# PostgreSQL is strictly opt-in. When DATABASE_ENABLED=false, DATABASE_URL is ignored
# and the application must not create a PostgreSQL pool or make a database network call.
DATABASE_ENABLED=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_testpilot
DATABASE_REQUIRED=false
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=1500
DATABASE_HEALTH_TIMEOUT_MS=1800
# When enabling PostgreSQL, run `npm run db:migrate` after creating the database.

# Platform authentication / roles
AUTH_REQUIRED=false
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=8h

# Source-aware developer remediation
GITHUB_SOURCE_TOKEN=
SOURCE_MAX_TREE_FILES=800
SOURCE_MAX_CANDIDATES=8
SOURCE_MAX_FILE_BYTES=180000

# AI test generation
# HARD UPPER LIMIT only. The AI coverage planner may generate fewer cases when fewer
# distinct evidence-grounded scenarios provide sufficient coverage; it must never pad to this number.
AI_TEST_CASE_COUNT=6
AI_GENERATION_CONCURRENCY=2

# Browser automation target fallback
TEST_BASE_URL=http://localhost:4000
AUTOMATION_BROWSER=chrome
AUTOMATION_HEADED=true

# Isolated execution
AUTOMATION_SCREENSHOT_EACH_TEST=true
AUTOMATION_TEST_COMPLETION_PAUSE_MS=5000
AUTOMATION_LIVE_STREAM=true
AUTOMATION_LIVE_STREAM_PORT=9223
AUTOMATION_VIDEO=false
AUTOMATION_SCREENSHOT_ON_FAILURE=true
AUTOMATION_STEP_DELAY_MS=150
AUTOMATION_ENGINE_TIMEOUT_MS=120000
AUTOMATION_ENGINE_EXIT_GRACE_MS=10000

# -----------------------------------------------------------------------------
# Advanced deterministic browser capabilities
# -----------------------------------------------------------------------------

# Visual regression. Approved PNG baselines live here. When false, a missing
# baseline fails the test instead of silently creating a new expected image.
AUTOMATION_VISUAL_BASELINE_DIR=./automation-system/baselines
AUTOMATION_VISUAL_UPDATE_BASELINES=false

# Safe browser file-upload fixtures. Generated tests may reference file names only;
# paths outside this directory are rejected by the runtime.
AUTOMATION_UPLOAD_FIXTURE_DIR=./automation-system/fixtures/uploads

# Camera/microphone tests can use Chromium fake media devices in controlled test runs.
AUTOMATION_FAKE_MEDIA_PERMISSIONS=false

# Named read-only database assertions. This is INDEPENDENT of DATABASE_ENABLED.
# DATABASE_ENABLED controls TestNexus platform persistence; these settings control
# an application-under-test DB verification adapter and are disabled by default.
AUTOMATION_DB_ASSERTIONS_ENABLED=false
AUTOMATION_DB_ASSERTION_URL=
AUTOMATION_DB_ASSERTION_TIMEOUT_MS=3000
# Map stable reviewed names to allow-listed SELECT/WITH statements only.
# Example: {"feedback_created":"SELECT status FROM feedback WHERE id=$1"}
AUTOMATION_DB_ASSERTION_QUERIES_JSON={}

# External capability adapter for workflows Cypress cannot safely/faithfully own:
# email/SMS/OTP providers, real cross-origin iframe control, real multi-tab browser
# contexts, non-production CAPTCHA/biometric bypass adapters, native mobile,
# browser-extension UI and native OS dialogs.
AUTOMATION_EXTERNAL_ADAPTER_URL=
AUTOMATION_EXTERNAL_ADAPTER_TOKEN=
AUTOMATION_EXTERNAL_ADAPTER_TIMEOUT_MS=15000
# Empty means all recognized adapter capabilities may be requested when an adapter URL
# is configured. To restrict it, use a comma-separated allow-list such as:
# EMAIL_SMS_OTP,CROSS_ORIGIN_IFRAME,REAL_MULTI_TAB,CAPTCHA_BIOMETRIC,NATIVE_MOBILE,BROWSER_EXTENSION,OS_DIALOG
AUTOMATION_EXTERNAL_CAPABILITIES=

# AI provider
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL_FAST=qwen3.5-flash
AI_MODEL_BALANCED=qwen3.7-plus
AI_MODEL_STRONG=qwen3.8-max
AI_MODEL_DEFAULT=strong
QWEN_MODEL=qwen3.5-flash
QWEN_TIMEOUT_MS=300000
QWEN_MAX_RETRIES=1

# Page-discovery cache
DISCOVERY_CACHE_TTL_MS=300000
