# AI TestPilot — demo configuration

# Demo application
DEMO_APP_PORT=4000

# AI TestPilot backend/UI
SERVER_PORT=5000

# AI test generation
# Keep the demo concise. Qwen is required to return exactly this many cases.
AI_TEST_CASE_COUNT=5

# Browser automation target fallback
TEST_BASE_URL=http://localhost:4000
AUTOMATION_BROWSER=chrome
AUTOMATION_HEADED=true

# Evidence capture
# Keep video off for the main headed Windows demo run while we avoid the
# Chrome/Cypress post-spec teardown lock. Failure screenshots remain enabled.
# Re-enable video after the browser lifecycle is stable, or capture video in a
# separate evidence-only rerun of failed cases.
AUTOMATION_VIDEO=false
AUTOMATION_SCREENSHOT_ON_FAILURE=true

# Optional demo presentation delay after visible browser actions.
# 0 = normal speed, 250-500 = good demo pace, 800+ = slow.
# Maximum accepted value is 3000 ms.
AUTOMATION_STEP_DELAY_MS=350

# Browser-engine lifecycle safety.
# Test results are captured before teardown. Give Chrome a little time to exit
# normally, then use the watchdog so statistics, AI analysis and the HTML report
# cannot remain blocked forever.
AUTOMATION_ENGINE_TIMEOUT_MS=120000
AUTOMATION_ENGINE_EXIT_GRACE_MS=10000

# Alibaba Cloud Model Studio / Qwen
# Keep the real key only in your local .env file. Never commit it.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-flash
# Model Studio can occasionally take longer than 90 seconds for structured generation.
# 180000 ms = 3 minutes per request attempt.
QWEN_TIMEOUT_MS=180000
QWEN_MAX_RETRIES=1
