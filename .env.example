# AI TestPilot — environment configuration

# --- Demo target application ---
DEMO_APP_PORT=4000

# --- AI TestPilot backend ---
SERVER_PORT=5000

# --- Target under test (used by the Cypress runner) ---
TEST_BASE_URL=http://localhost:4000

# --- Qwen (Alibaba Cloud Model Studio) ---
# Leave blank to run in mock mode (no API calls made, deterministic
# responses used instead) — useful for demos without live credentials.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# --- PostgreSQL (optional — for storing story/test-case/results history) ---
# Leave blank to run without persistence (app works normally, history isn't saved).
# Unlike MySQL, Postgres needs the database created BEFORE you run the schema:
#   createdb ai_testpilot
#   psql -U <user> -d ai_testpilot -f server/db/schema.sql
# Power BI connects directly to this same database (Get Data -> PostgreSQL database).
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=ai_testpilot
