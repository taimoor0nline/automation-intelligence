# AI TestPilot — environment configuration

# --- Demo target application ---
DEMO_APP_PORT=4000

# --- AI TestPilot backend ---
SERVER_PORT=5000

# --- Target under test (used by the Cypress runner) ---
TEST_BASE_URL=http://localhost:4000

# --- Qwen (Alibaba Cloud Model Studio) ---
# Leave blank to run in mock mode (no API calls made, deterministic
# responses used instead).
#
# QWEN_BASE_URL depends on which region your account/key is in — using the
# wrong one is the #1 cause of 401 errors, even with a correct key:
#   Singapore (most international accounts): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Beijing / China mainland accounts:        https://dashscope.aliyuncs.com/compatible-mode/v1
#
QWEN_API_KEY=sk-ws-H.DMYERHP.51ib.MEUCIEX1e3-w9Ryqobv3lM0PLHO6ILs929VBYnbXgSZSaizWAiEA68n39HDSt2DxgYuR0mP16Ldi54IWGkCwsao6VjAoy6w
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus