# AI TestPilot — demo configuration

# Demo application
DEMO_APP_PORT=4000

# AI TestPilot backend/UI
SERVER_PORT=5000

# AI test generation
# Keep the demo concise. The AI provider is required to return exactly this many cases.
AI_TEST_CASE_COUNT=5

# Browser automation target fallback
TEST_BASE_URL=http://localhost:4000
AUTOMATION_BROWSER=chrome
AUTOMATION_HEADED=true

# Evidence capture
AUTOMATION_VIDEO=false
AUTOMATION_SCREENSHOT_ON_FAILURE=true

# Optional demo presentation delay after visible browser actions.
# 0 = normal speed, 250-500 = good demo pace, 800+ = slow.
# Maximum accepted value is 3000 ms.
AUTOMATION_STEP_DELAY_MS=350

# Browser-engine lifecycle safety.
AUTOMATION_ENGINE_TIMEOUT_MS=120000
AUTOMATION_ENGINE_EXIT_GRACE_MS=10000

# AI provider
# Keep the real key only in your local .env file. Never commit it.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Three selectable server-side model profiles. The public UI exposes only
# Fast / Balanced / Strong and never reveals provider/model names.
# Change these IDs to models available in your Model Studio region/account.
AI_MODEL_FAST=qwen3.5-flash
AI_MODEL_BALANCED=qwen3.5-plus
AI_MODEL_STRONG=qwen3.7-plus
AI_MODEL_DEFAULT=fast

# Backward-compatible fallback used only when AI_MODEL_FAST is not set.
QWEN_MODEL=qwen3.5-flash

# Model Studio request controls.
QWEN_TIMEOUT_MS=180000
QWEN_MAX_RETRIES=1

# Page-discovery cache. 300000 = 5 minutes. Set to 0 to disable globally.
# The UI also provides a "Fresh page discovery" option to bypass cache per run.
DISCOVERY_CACHE_TTL_MS=300000
