{
  "name": "ai-testpilot-poc",
  "version": "2.3.0",
  "private": true,
  "description": "TestNexus AI — persistent source-aware Cypress automation platform",
  "scripts": {
    "postinstall": "npm run automation:install",
    "automation:install": "npm install --prefix automation-system --include=dev",
    "start:demo-app": "node demo-app/server.js",
    "start:server": "node server/index.js",
    "start": "concurrently -n demo-app,server -c blue,green \"npm:start:demo-app\" \"npm:start:server\"",
    "db:migrate": "node server/db/migrate.js",
    "test:platform": "node scripts/platform-smoke.js",
    "test:rest": "node scripts/rest-smoke.js",
    "test:canonical-architecture": "node scripts/canonical-architecture-smoke.js",
    "test:assertion-grounding": "node scripts/assertion-grounding-regression-smoke.js",
    "test:readiness-normalization": "node scripts/readiness-normalization-smoke.js",
    "test:readiness-v13": "node scripts/readiness-v13-regression-smoke.js",
    "test:advanced-capabilities": "node scripts/advanced-capabilities-smoke.js",
    "test:story-discovery": "node scripts/story-discovery-compatibility-smoke.js",
    "test:capabilities": "node scripts/canonical-architecture-smoke.js && node scripts/capability-smoke.js && node scripts/readiness-regression-smoke.js && node scripts/readiness-normalization-smoke.js && node scripts/readiness-v13-regression-smoke.js && node scripts/assertion-grounding-regression-smoke.js && node scripts/advanced-capabilities-smoke.js && node scripts/story-discovery-compatibility-smoke.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "ws": "^8.18.3",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
