{
  "name": "ai-testpilot-poc",
  "version": "2.3.0",
  "private": true,
  "description": "AI TestPilot — persistent source-aware Cypress automation platform",
  "scripts": {
    "start:demo-app": "node demo-app/server.js",
    "start:server": "node server/index.js",
    "start": "concurrently -n demo-app,server -c blue,green \"npm:start:demo-app\" \"npm:start:server\"",
    "db:migrate": "node server/db/migrate.js",
    "test:platform": "node scripts/platform-smoke.js",
    "test:capabilities": "node scripts/capability-smoke.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "ws": "^8.18.3",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
